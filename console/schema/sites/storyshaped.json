            },
            {
              "value": "Vintage Items",
              "label": "Vintage Items"
            },
            {
              "value": "Vintage Glass/Supplies",
              "label": "Vintage Glass/Supplies"
            }
          ],
          "help": "The Etsy shop section, and the site's own category."
        },
        {
          "name": "etsyCategory",
          "kind": "text",
          "label": "Etsy category",
          "required": true,
          "maxLength": 200,
          "help": "Etsy's category path, e.g. Jewelry < Rings < Statement Rings, or Craft Supplies & Tools < Beads, Gems & Cabochons < Beads."
        },
        {
          "name": "ebayCategoryId",
          "kind": "text",
          "label": "eBay category id",
          "maxLength": 20,
          "pattern": "[0-9]+",
          "patternHelp": "digits only"
        },
        {
          "name": "tags",
          "kind": "list",
          "label": "Tags",
          "required": true,

            },
            {
              "value": "Uranium Glass Bracelets",
              "label": "Uranium Glass Bracelets"
            },
            {
              "value": "Vintage Uranium Jewelry",
              "label": "Vintage Uranium Jewelry"
            },
            {
              "value": "Gold Uranium Glass",

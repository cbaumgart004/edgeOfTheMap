              "value": "Italiana",
              "label": "Italiana"
            },
            {
              "value": "Federo",
              "label": "Federo"
            },
            {
              "value": "Playfair Display",
              "label": "Playfair Display"
            }
          ]
        },
        {
          "name": "bodyFont",
          "kind": "select",
          "label": "Body font",
          "options": [
            {
              "value": "",
              "label": "Futura / Century Gothic (current)"
            },
            {
              "value": "Josefin Sans",
              "label": "Josefin Sans"
            },
            {
              "value": "Montserrat",
              "label": "Montserrat"
            },
            {
              "value": "Raleway",
              "label": "Raleway"
            },
            {
              "value": "Lato",
              "label": "Lato"
            },
            {
              "value": "Nunito Sans",
              "label": "Nunito Sans"
            },
            {
              "value": "Cormorant Garamond",
              "label": "Cormorant Garamond"
            },
            {
              "value": "EB Garamond",
              "label": "EB Garamond"
            }
          ]
        },
        {
          "name": "blacklight",
          "kind": "group",
          "label": "Blacklight",
          "fields": [
            {
              "name": "background",
              "kind": "color",
              "label": "Background",
              "help": "Blank: #060806, the site’s own. Changing a colour recolours the glow; it keeps its shape."
            },
            {
              "name": "accent",
              "kind": "color",
              "label": "Accent (headings, links, buttons)",
              "help": "Blank: #00fb00, the site’s own. Changing a colour recolours the glow; it keeps its shape."
            },
            {
              "name": "text",
              "kind": "color",
              "label": "Text",
              "help": "Blank: #d9f2d9, the site’s own. Changing a colour recolours the glow; it keeps its shape."
            },
            {
              "name": "muted",
              "kind": "color",
              "label": "Quiet text",
              "help": "Blank: #72ca72, the site’s own. Changing a colour recolours the glow; it keeps its shape."
            },
            {
              "name": "glow",
              "kind": "color",
              "label": "Glow colour",
              "help": "Blank: the accent, the site’s own. Changing a colour recolours the glow; it keeps its shape."
            },
            {
              "name": "glowStrength",
              "kind": "number",
              "label": "Glow strength",
              "integer": true,
              "min": 0,
              "max": 200,
              "step": 5,
              "slider": true,
              "unit": "%",
              "sliderDefault": 100,
              "help": "How bright the tight glow around letters and edges is. 100% is today’s; 0% turns it off."
            },
            {
              "name": "glowHaze",
              "kind": "number",
              "label": "Glow haze",
              "integer": true,
              "min": 0,
              "max": 200,
              "step": 5,
              "slider": true,
              "unit": "%",
              "sliderDefault": 100,
              "help": "Only the soft, diffuse part: the outer halo and the wash at the top of the page. 100% is today’s; lower it to calm the bloom."
            },
            {
              "name": "glowSpread",
              "kind": "number",
              "label": "Glow reach",
              "integer": true,
              "min": 25,
              "max": 200,
              "step": 5,
              "slider": true,
              "unit": "%",
              "sliderDefault": 100,
              "help": "How far every layer of the glow spreads. 100% is today’s; 50% is a tight neon edge."
            },
            {
              "name": "glowPulse",
              "kind": "select",
              "label": "Glow movement",
              "default": "",
              "options": [
                {
                  "value": "",
                  "label": "Steady"
                },
                {
                  "value": "breathe",
                  "label": "Slow breathe"
                },
                {
                  "value": "flicker",
                  "label": "Neon flicker"
                }
              ],
              "help": "Visitors who ask their device for less motion always see it steady."
            }
          ],
          "collapsible": true
        },

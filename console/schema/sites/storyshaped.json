            "defaultMode",
            "rememberChoice",
            "headingFont",
            "bodyFont"
          ]
        },
        {
          "label": "Blacklight theme",
          "mode": "blacklight",
          "help": "Colours and glow under blacklight",
          "fields": [
            "blacklight",
            "defaultMode",
            "rememberChoice",
            "headingFont",
            "bodyFont"
          ]
        }
      ]
    },
    "siteSettings": {
      "label": "Site header and footer",
      "plural": "Site header and footer",
      "singleton": true,
      "previewPath": "/meet-the-artist",
      "fields": [
        {
          "name": "siteName",
          "kind": "text",
          "label": "Site name",
          "default": "StoryShaped Studios",
          "help": "The name at the top of every page but Home, and in the footer and copyright."
        },
        {
          "name": "socials",
          "kind": "list",
          "label": "Social and shop links",
          "itemLabel": "label",
          "default": [
            {
              "_id": "social-1",
              "label": "Etsy",
              "url": "https://www.etsy.com/shop/storyshapedstudios/?etsrc=sdt",
              "icon": "etsy",
              "inBand": false
            },
            {
              "_id": "social-2",
              "label": "eBay",
              "url": "https://www.ebay.com/str/storyshapedstudios",
              "icon": "ebay",
              "inBand": false
            },
            {
              "_id": "social-3",
              "label": "Facebook",
              "url": "https://www.facebook.com/storyshapedstudios/",
              "icon": "facebook",
              "inBand": true
            },
            {
              "_id": "social-4",
              "label": "Instagram",

{
  "site": "storyshaped",
  "version": 1,
  "release": {
    "types": [
      "page",
      "pageLayout",
      "referencePage",
      "theme",
      "siteSettings"
    ]
  },
  "tools": [
    {
      "label": "Inventory",
      "path": "/admin/inventory",
      "help": "Stock items, counts, bills of materials; hidden from visitors"
    }
  ],
  "brand": {
    "name": "StoryShaped Studios",
    "logo": "/assets/StoryShapedStudiosLogo_GmailOptimized.png",
    "modeSource": {
      "selector": ".sss-home",
      "attribute": "data-mode",
      "map": {
        "daylight": "light",
        "blacklight": "dark"
      }
    },
    "modes": {
      "light": {
        "bg": "#0f1512",
        "surface": "#151d18",
        "ink": "#eef2d9",
        "muted": "#b3ca73",
        "line": "rgba(217,255,107,0.28)",
        "accent": "#d9ff6b",
        "accentInk": "#0f1512"
      },
      "dark": {
        "bg": "#060806",
        "surface": "#0d140d",
        "ink": "#d9f2d9",
        "muted": "#72ca72",
        "line": "rgba(0,251,0,0.35)",
        "accent": "#00fb00",
        "accentInk": "#060806"
      }
    },
    "fonts": {
      "body": "'Century Gothic', Futura, sans-serif",
      "heading": "'Poiret One', sans-serif"
    },
    "radius": "4px"
  },
  "textStyles": [
    {
      "name": "glow",
      "label": "Uranium glow",
      "className": "uv-glow"
    },
    {
      "name": "accent",
      "label": "Accent",
      "className": "text-accent"
    }
  ],
  "types": {
    "libraryArticle": {
      "label": "Library entry",
      "plural": "Library entries",
      "menuUnder": "page",
      "titleField": "title",
      "slugFrom": "title",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "label": "Question or title",
          "required": true
        },
        {
          "name": "body",
          "kind": "richtext",
          "label": "Entry",
          "required": true
        },
        {
          "name": "sources",
          "kind": "list",
          "label": "Sources",
          "itemLabel": "title",
          "help": "Each shows as its title, with the site and address in small type beneath.",
          "fields": [
            {
              "name": "title",
              "kind": "text",
              "label": "Title",
              "help": "What a reader sees, e.g. \"Victorian jewellery (Wikipedia)\". Blank: made from the address."
            },
            {
              "name": "url",
              "kind": "url",
              "label": "Address",
              "required": true
            }
          ]
        },
        {
          "name": "after",
          "kind": "placement",
          "label": "Place in contents",
          "help": "Where this entry appears in the Library's contents."
        }
      ],
      "previewPath": "/library/{slug}"
    },
    "page": {
      "label": "Page",
      "plural": "Pages",
      "titleField": "title",
      "slugFrom": "title",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "label": "Title",
          "required": true,
          "help": "Home is the page whose address is \"home\"; it shows at the site’s front door."
        },
        {
          "name": "sections",
          "kind": "blocks",
          "label": "Sections",
          "of": [
            "hero",
            "card",
            "values",
            "photoFeature",
            "productCard"
          ],
          "help": "The components this page is made of, in order. Arrange them side by side with its Page layout."
        }
      ],
      "previewPath": "/{slug}"
    },
    "pageLayout": {
      "label": "Page layout",
      "plural": "Page layouts",
      "titleField": "title",
      "slugFrom": "title",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "label": "Page",
          "required": true
        },
        {
          "name": "path",
          "kind": "url",
          "label": "Address",
          "required": true,
          "help": "The page this arranges: / for Home."
        },
        {
          "name": "blocks",
          "kind": "layout",
          "label": "Arrangement",
          "help": "Drag the blocks on the page, or order and size them here."
        }
      ],
      "previewPath": "{path}"
    },
    "referencePage": {
      "label": "Reference Page Layout",
      "plural": "Reference Page Layouts",
      "menuUnder": "pageLayout",
      "titleField": "title",
      "slugFrom": "title",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "label": "Title",
          "required": true,
          "default": "Glossary of Terms"
        },
        {
          "name": "path",
          "kind": "url",
          "label": "Address",
          "required": true,
          "default": "/glossary",
          "help": "The page this fills: /glossary for the Glossary."
        },
        {
          "name": "eyebrow",
          "kind": "text",
          "label": "Small heading above the title",
          "default": "Reference"
        },
        {
          "name": "intro",
          "kind": "textarea",
          "label": "Introduction",
          "help": "Under the title. The term count and a link to the Library follow it."
        },
        {
          "name": "sections",
          "kind": "list",
          "label": "Sections",
          "itemLabel": "heading",
          "help": "Each is a category with its own jump button.",
          "fields": [
            {
              "name": "heading",
              "kind": "text",
              "label": "Category",
              "required": true
            },
            {
              "name": "terms",
              "kind": "list",
              "label": "Terms",
              "itemLabel": "term",
              "fields": [
                {
                  "name": "term",
                  "kind": "text",
                  "label": "Term",
                  "required": true
                },
                {
                  "name": "definition",
                  "kind": "richtext",
                  "label": "Definition",
                  "required": true
                },
                {
                  "name": "details",
                  "kind": "list",
                  "label": "Details",
                  "itemLabel": "label",
                  "help": "Labelled sub-definitions, e.g. rhinestone grades.",
                  "fields": [
                    {
                      "name": "label",
                      "kind": "text",
                      "label": "Label"
                    },
                    {
                      "name": "text",
                      "kind": "textarea",
                      "label": "Text",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "sources",
                  "kind": "list",
                  "label": "Sources",
                  "itemLabel": "title",
                  "help": "Each shows as its title, with the site and address in small type beneath.",
                  "fields": [
                    {
                      "name": "title",
                      "kind": "text",
                      "label": "Title",
                      "help": "What a reader sees, e.g. \"Victorian jewellery (Wikipedia)\". Blank: made from the address."
                    },
                    {
                      "name": "url",
                      "kind": "url",
                      "label": "Address",
                      "required": true
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "libraryIndex",
          "kind": "list",
          "label": "Library index",
          "itemLabel": "group",
          "help": "Groups of Library entries, by their exact titles.",
          "fields": [
            {
              "name": "group",
              "kind": "text",
              "label": "Group",
              "required": true
            },
            {
              "name": "entries",
              "kind": "list",
              "label": "Entries",
              "itemLabel": "title",
              "fields": [
                {
                  "name": "title",
                  "kind": "text",
                  "label": "Library entry title",
                  "required": true
                }
              ]
            }
          ]
        }
      ],
      "previewPath": "{path}"
    },
    "theme": {
      "label": "Theme",
      "plural": "Theme",
      "singleton": true,
      "previewPath": "/",
      "fields": [
        {
          "name": "defaultMode",
          "kind": "select",
          "label": "Opens in",
          "default": "blacklight",
          "options": [
            {
              "value": "blacklight",
              "label": "Blacklight"
            },
            {
              "value": "daylight",
              "label": "Light"
            }
          ],
          "help": "The look a visitor first sees."
        },
        {
          "name": "rememberChoice",
          "kind": "boolean",
          "label": "Remember each visitor’s last choice",
          "help": "Off: every visit opens in the look above, even for someone who switched last time. On: a returning visitor sees what they last chose."
        },
        {
          "name": "headingFont",
          "kind": "select",
          "label": "Heading font",
          "options": [
            {
              "value": "",
              "label": "Poiret One (current)"
            },
            {
              "value": "Josefin Sans",
              "label": "Josefin Sans"
            },
            {
              "value": "Limelight",
              "label": "Limelight"
            },
            {
              "value": "Cinzel",
              "label": "Cinzel"
            },
            {
              "value": "Marcellus",
              "label": "Marcellus"
            },
            {
              "value": "Italiana",
              "label": "Italiana"
            },
            {
              "value": "Federo",
              "label": "Federo"
            },
            {
              "value": "Playfair Display",
              "label": "Playfair Display"
            }
          ]
        },
        {
          "name": "bodyFont",
          "kind": "select",
          "label": "Body font",
          "options": [
            {
              "value": "",
              "label": "Futura / Century Gothic (current)"
            },
            {
              "value": "Josefin Sans",
              "label": "Josefin Sans"
            },
            {
              "value": "Montserrat",
              "label": "Montserrat"
            },
            {
              "value": "Raleway",
              "label": "Raleway"
            },
            {
              "value": "Lato",
              "label": "Lato"
            },
            {
              "value": "Nunito Sans",
              "label": "Nunito Sans"
            },
            {
              "value": "Cormorant Garamond",
              "label": "Cormorant Garamond"
            },
            {
              "value": "EB Garamond",
              "label": "EB Garamond"
            }
          ]
        },
        {
          "name": "blacklight",
          "kind": "group",
          "label": "Blacklight",
          "fields": [
            {
              "name": "background",
              "kind": "color",
              "label": "Background",
              "help": "Blank: #060806, the site’s own. Changing a colour recolours the glow; it keeps its shape."
            },
            {
              "name": "accent",
              "kind": "color",
              "label": "Accent (headings, links, buttons)",
              "help": "Blank: #00fb00, the site’s own. Changing a colour recolours the glow; it keeps its shape."
            },
            {
              "name": "text",
              "kind": "color",
              "label": "Text",
              "help": "Blank: #d9f2d9, the site’s own. Changing a colour recolours the glow; it keeps its shape."
            },
            {
              "name": "muted",
              "kind": "color",
              "label": "Quiet text",
              "help": "Blank: #72ca72, the site’s own. Changing a colour recolours the glow; it keeps its shape."
            },
            {
              "name": "glow",
              "kind": "color",
              "label": "Glow colour",
              "help": "Blank: the accent, the site’s own. Changing a colour recolours the glow; it keeps its shape."
            },
            {
              "name": "glowStrength",
              "kind": "number",
              "label": "Glow strength",
              "integer": true,
              "min": 0,
              "max": 200,
              "step": 5,
              "slider": true,
              "unit": "%",
              "sliderDefault": 100,
              "help": "How bright the tight glow around letters and edges is. 100% is today’s; 0% turns it off."
            },
            {
              "name": "glowHaze",
              "kind": "number",
              "label": "Glow haze",
              "integer": true,
              "min": 0,
              "max": 200,
              "step": 5,
              "slider": true,
              "unit": "%",
              "sliderDefault": 100,
              "help": "Only the soft, diffuse part: the outer halo and the wash at the top of the page. 100% is today’s; lower it to calm the bloom."
            },
            {
              "name": "glowSpread",
              "kind": "number",
              "label": "Glow reach",
              "integer": true,
              "min": 25,
              "max": 200,
              "step": 5,
              "slider": true,
              "unit": "%",
              "sliderDefault": 100,
              "help": "How far every layer of the glow spreads. 100% is today’s; 50% is a tight neon edge."
            },
            {
              "name": "glowPulse",
              "kind": "select",
              "label": "Glow movement",
              "default": "",
              "options": [
                {
                  "value": "",
                  "label": "Steady"
                },
                {
                  "value": "breathe",
                  "label": "Slow breathe"
                },
                {
                  "value": "flicker",
                  "label": "Neon flicker"
                }
              ],
              "help": "Visitors who ask their device for less motion always see it steady."
            }
          ],
          "collapsible": true
        },
        {
          "name": "daylight",
          "kind": "group",
          "label": "Light",
          "fields": [
            {
              "name": "background",
              "kind": "color",
              "label": "Background",
              "help": "Blank: #0f1512, the site’s own. Changing a colour recolours the glow; it keeps its shape."
            },
            {
              "name": "accent",
              "kind": "color",
              "label": "Accent (headings, links, buttons)",
              "help": "Blank: #d9ff6b (vaseline), the site’s own. Changing a colour recolours the glow; it keeps its shape."
            },
            {
              "name": "text",
              "kind": "color",
              "label": "Text",
              "help": "Blank: #eef2d9, the site’s own. Changing a colour recolours the glow; it keeps its shape."
            },
            {
              "name": "muted",
              "kind": "color",
              "label": "Quiet text",
              "help": "Blank: #b3ca73, the site’s own. Changing a colour recolours the glow; it keeps its shape."
            },
            {
              "name": "glow",
              "kind": "color",
              "label": "Glow colour",
              "help": "Blank: the accent, the site’s own. Changing a colour recolours the glow; it keeps its shape."
            },
            {
              "name": "glowStrength",
              "kind": "number",
              "label": "Glow strength",
              "integer": true,
              "min": 0,
              "max": 200,
              "step": 5,
              "slider": true,
              "unit": "%",
              "sliderDefault": 100,
              "help": "How bright the tight glow around letters and edges is. 100% is today’s; 0% turns it off."
            },
            {
              "name": "glowHaze",
              "kind": "number",
              "label": "Glow haze",
              "integer": true,
              "min": 0,
              "max": 200,
              "step": 5,
              "slider": true,
              "unit": "%",
              "sliderDefault": 100,
              "help": "Only the soft, diffuse part: the outer halo and the wash at the top of the page. 100% is today’s; lower it to calm the bloom."
            },
            {
              "name": "glowSpread",
              "kind": "number",
              "label": "Glow reach",
              "integer": true,
              "min": 25,
              "max": 200,
              "step": 5,
              "slider": true,
              "unit": "%",
              "sliderDefault": 100,
              "help": "How far every layer of the glow spreads. 100% is today’s; 50% is a tight neon edge."
            },
            {
              "name": "glowPulse",
              "kind": "select",
              "label": "Glow movement",
              "default": "",
              "options": [
                {
                  "value": "",
                  "label": "Steady"
                },
                {
                  "value": "breathe",
                  "label": "Slow breathe"
                },
                {
                  "value": "flicker",
                  "label": "Neon flicker"
                }
              ],
              "help": "Visitors who ask their device for less motion always see it steady."
            }
          ],
          "collapsible": true
        }
      ]
    },
    "siteSettings": {
      "label": "Site header and footer",
      "plural": "Site header and footer",
      "singleton": true,
      "previewPath": "/meet-the-artist",
      "fields": [
        {
          "name": "siteName",
          "kind": "text",
          "label": "Site name",
          "default": "StoryShaped Studios",
          "help": "The name at the top of every page but Home, and in the footer and copyright."
        },
        {
          "name": "navLinks",
          "kind": "list",
          "label": "Menu",
          "itemLabel": "label",
          "help": "The links along the top, in order. The page a visitor is on leaves its own link out.",
          "default": [
            {
              "_id": "nav-1",
              "label": "Home",
              "url": "/",
              "soon": false
            },
            {
              "_id": "nav-2",
              "label": "Library",
              "url": "/library",
              "soon": false
            },
            {
              "_id": "nav-3",
              "label": "Glossary",
              "url": "/glossary",
              "soon": false
            },
            {
              "_id": "nav-4",
              "label": "Images",
              "url": "/images",
              "soon": true
            },
            {
              "_id": "nav-5",
              "label": "Meet the Artist",
              "url": "/meet-the-artist",
              "soon": false
            }
          ],
          "fields": [
            {
              "name": "label",
              "kind": "text",
              "label": "Label",
              "required": true
            },
            {
              "name": "url",
              "kind": "url",
              "label": "Goes to",
              "required": true
            },
            {
              "name": "soon",
              "kind": "boolean",
              "label": "Coming soon (shown dimmed, not a link)"
            }
          ]
        },
        {
          "name": "socials",
          "kind": "list",
          "label": "Social and shop links",
          "itemLabel": "label",
          "default": [
            {
              "_id": "social-1",
              "label": "Etsy",
              "url": "https://www.etsy.com/shop/storyshapedstudios/?etsrc=sdt",
              "icon": "etsy",
              "inBand": false
            },
            {
              "_id": "social-2",
              "label": "eBay",
              "url": "https://www.ebay.com/str/storyshapedstudios",
              "icon": "ebay",
              "inBand": false
            },
            {
              "_id": "social-3",
              "label": "Facebook",
              "url": "https://www.facebook.com/storyshapedstudios/",
              "icon": "facebook",
              "inBand": true
            },
            {
              "_id": "social-4",
              "label": "Instagram",
              "url": "https://www.instagram.com/storyshaped_studios/?hl=en",
              "icon": "instagram",
              "inBand": true
            }
          ],
          "fields": [
            {
              "name": "label",
              "kind": "text",
              "label": "Name",
              "required": true
            },
            {
              "name": "url",
              "kind": "url",
              "label": "Address",
              "required": true
            },
            {
              "name": "icon",
              "kind": "select",
              "label": "Icon",
              "required": true,
              "options": [
                {
                  "value": "etsy",
                  "label": "Etsy"
                },
                {
                  "value": "ebay",
                  "label": "eBay"
                },
                {
                  "value": "facebook",
                  "label": "Facebook"
                },
                {
                  "value": "instagram",
                  "label": "Instagram"
                }
              ]
            },
            {
              "name": "inBand",
              "kind": "boolean",
              "label": "Also in the band under the menu"
            }
          ]
        },
        {
          "name": "daylightLabel",
          "kind": "text",
          "label": "Toggle label, daylight",
          "default": "Daylight"
        },
        {
          "name": "blacklightLabel",
          "kind": "text",
          "label": "Toggle label, blacklight",
          "default": "Blacklight"
        }
      ]
    },
    "listing": {
      "label": "Listing",
      "plural": "Listings",
      "titleField": "title",
      "slugFrom": "title",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "label": "Title",
          "required": true,
          "maxLength": 140,
          "help": "As buyers see it on every Marketplace. Etsy allows 140 characters."
        },
        {
          "name": "description",
          "kind": "textarea",
          "label": "Description",
          "required": true,
          "maxLength": 10000
        },
        {
          "name": "photos",
          "kind": "photos",
          "label": "Photos",
          "required": true,
          "indexes": [
            "Light",
            "Dark"
          ],
          "maxItems": 10,
          "help": "Label each Light (daylight) or Dark (blacklight). The site pairs the first Light with the first Dark, the second with the second, for the blacklight toggle; a photo with no partner gets a blacklight tint instead. A half-and-half or scale photo is Light. Etsy takes 10.",
          "warnMissingIndex": true,
          "missingIndexHelp": "The blacklight toggle will tint the photos it has instead of switching to a real shot."
        },
        {
          "name": "section",
          "kind": "select",
          "label": "Shop section",
          "required": true,
          "options": [
            {
              "value": "NEW in September",
              "label": "NEW in September"
            },
            {
              "value": "Houze Factory Glass",
              "label": "Houze Factory Glass"
            },
            {

            },
            {
              "name": "glowStrength",
              "kind": "number",
              "label": "Glow strength",
              "integer": true,
              "min": 0,
              "max": 200,
              "step": 5,
              "slider": true,
              "unit": "%",
              "sliderDefault": 100,
              "help": "How bright the tight glow around letters and edges is. 100% is today’s; 0% turns it off."
            },
            {
              "name": "glowHaze",
              "kind": "number",
              "label": "Glow haze",
              "integer": true,
              "min": 0,

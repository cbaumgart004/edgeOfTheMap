              "icon": "instagram",
              "inBand": true
            }
          ],
          "fields": [
            {
              "name": "label",
              "kind": "text",
              "label": "Name",
              "required": true
            },
            {
              "name": "url",
              "kind": "url",
              "label": "Address",
              "required": true
            },
            {
              "name": "icon",
              "kind": "select",
              "label": "Icon",
              "options": [
                {
                  "value": "etsy",
                  "label": "Etsy"
                },
                {
                  "value": "ebay",
                  "label": "eBay"
                },
                {
                  "value": "facebook",
                  "label": "Facebook"
                },
                {
                  "value": "instagram",
                  "label": "Instagram"
                }
              ],
              "help": "Or add a Photo field to these links (+ Add a field) for your own picture; a photo shows instead of the icon."
            },
            {
              "name": "inBand",
              "kind": "boolean",
              "label": "Also in the band under the menu"
            }
          ]
        },
        {
          "name": "copyrightOwner",
          "kind": "text",
          "label": "Copyright owner",
          "default": "StoryShaped Studios",

{
  "site": "storyshaped",
  "connections": [
    {"label": "Social links", "type": "siteSettings", "field": "socials", "detail": "Shown in the site footer."}
  ],
  "version": 1,
  "tools": [
    {
      "label": "Inventory",
      "path": "/admin/inventory",
      "help": "Stock items, counts, bills of materials; hidden from visitors"
    }
  ],
  "images": {
    "type": "imagePair",
    "label": "Image dictionary",
    "summary": "Daylight and blacklight pairs (private)",
    "help": "Private to the editor: every daylight and blacklight pair on the site, your Image pairs, your Listings’ photos and your pages’ photos. A side with no photo takes an upload. This is not a page of the site; the Images page is its own, built from Image with text sections."
  },
  "brand": {
    "name": "StoryShaped Studios",
    "logo": "/assets/StoryShapedStudiosLogo_GmailOptimized.png",
    "modeSource": {
      "selector": ".sss-home",
      "attribute": "data-mode",
      "map": {
        "daylight": "light",
        "blacklight": "dark"
      }
    },
    "modes": {
      "light": {
        "bg": "#0f1512",
        "surface": "#151d18",
        "ink": "#eef2d9",
        "muted": "#b3ca73",
        "line": "rgba(217,255,107,0.28)",
        "accent": "#d9ff6b",
        "accentInk": "#0f1512"
      },
      "dark": {
        "bg": "#060806",
        "surface": "#0d140d",
        "ink": "#d9f2d9",
        "muted": "#72ca72",
        "line": "rgba(0,251,0,0.35)",
        "accent": "#00fb00",
        "accentInk": "#060806"
      }
    },
    "fonts": {
      "body": "'Century Gothic', Futura, sans-serif",
      "heading": "'Poiret One', sans-serif"
    },
    "radius": "4px"
  },
  "textStyles": [
    {
      "name": "glow",
      "label": "Uranium glow",
      "className": "uv-glow"
    },
    {
      "name": "accent",
      "label": "Accent",
      "className": "text-accent"
    }
  ],
  "styleColors": [
    {
      "value": "accent",
      "label": "Accent (follows the theme)",
      "css": "var(--accent)"
    },
    {
      "value": "text",
      "label": "Text",
      "css": "var(--bone)"
    },
    {
      "value": "muted",
      "label": "Quiet text",
      "css": "var(--muted)"
    },
    {
      "value": "background",
      "label": "Background",
      "css": "var(--void)"
    }
  ],
  "buttonStyles": [
    {
      "value": "primary",
      "label": "Primary",
      "className": "btn btn-primary"
    },
    {
      "value": "ghost",
      "label": "Outline",
      "className": "btn btn-ghost"
    }
  ],
  "classes": [
    {
      "name": "btn",
      "label": "Buttons",
      "selector": ".sss-home .btn"
    },
    {
      "name": "sectionHeading",
      "label": "Section headings",
      "selector": ".sss-home .section h2"
    },
    {
      "name": "eyebrow",
      "label": "Small headings above a heading",
      "selector": ".sss-home .eyebrow"
    },
    {
      "name": "bodyText",
      "label": "Body text",
      "selector": ".sss-home .page-rich"
    },
    {
      "name": "pieceCard",
      "label": "Photo cards",
      "selector": ".sss-home .piece-card"
    },
    {
      "name": "navLinks",
      "label": "Menu links",
      "selector": ".sss-home .sss-navlinks a"
    },
    {
      "name": "footer",
      "label": "Footer",
      "selector": ".sss-home .sss-footer"
    },
    {
      "name": "imageText",
      "label": "Image with text",
      "selector": ".sss-home .image-text"
    },
    {
      "name": "banner",
      "label": "Banners",
      "selector": ".sss-home .banner"
    }
  ],
  "templates": [
    {
      "name": "Banner: collection coming soon",
      "block": {
        "_type": "banner",
        "heading": "Collection Coming Soon",
        "text": "Our pieces are on Etsy and eBay while the shop here is being built.",
        "links": [
          {
            "_id": "banner-etsy",
            "label": "StoryShaped Studios on Etsy",
            "url": "https://www.etsy.com/shop/storyshapedstudios/?etsrc=sdt",
            "look": "primary"
          },
          {
            "_id": "banner-ebay",
            "label": "StoryShaped Studios on eBay",
            "url": "https://www.ebay.com/str/storyshapedstudios",
            "look": "ghost"
          }
        ]
      }
    }
  ],
  "previewScope": {
    "className": "sss-home"
  },
  "types": {
    "libraryArticle": {
      "label": "Library entry",
      "plural": "Library entries",
      "menuUnder": "page",
      "titleField": "title",
      "slugFrom": "title",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "label": "Question or title",
          "required": true
        },
        {
          "name": "body",
          "kind": "richtext",
          "label": "Entry",
          "required": true
        },
        {
          "name": "sources",
          "kind": "list",
          "label": "Sources",
          "itemLabel": "title",
          "help": "Each shows as its title, with the site and address in small type beneath.",
          "fields": [
            {
              "name": "title",
              "kind": "text",
              "label": "Title",
              "help": "What a reader sees, e.g. \"Victorian jewellery (Wikipedia)\". Blank: made from the address."
            },
            {
              "name": "url",
              "kind": "url",
              "label": "Address",
              "required": true
            }
          ]
        },
        {
          "name": "after",
          "kind": "placement",
          "label": "Place in contents",
          "help": "Where this entry appears in the Library's contents."
        }
      ],
      "previewPath": "/library/{slug}"
    },
    "page": {
      "label": "Page",
      "plural": "Pages",
      "titleField": "title",
      "slugFrom": "title",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "label": "Title",
          "required": true,
          "help": "Home is the page whose address is \"home\"; it shows at the site’s front door."
        },
        {
          "name": "sections",
          "kind": "blocks",
          "label": "Sections",
          "of": [
            "hero",
            "card",
            "values",
            "photoFeature",
            "productCard",
            "pairGallery",
            "imageText",
            "banner"
          ],
          "help": "The components this page is made of, in order. Arrange them side by side with its Page layout."
        },
        {
          "name": "librarySidebar",
          "kind": "group",
          "label": "Library sidebar",
          "collapsible": true,
          "help": "Used on the Library page only: the headings over its Most viewed and Contents lists.",
          "fields": [
            { "name": "mostViewed", "kind": "text", "label": "Most viewed heading", "default": "Most viewed" },
            { "name": "contents", "kind": "text", "label": "Contents heading", "default": "Contents" }
          ]
        }
      ],
      "previewPath": "/{slug}"
    },
    "pageLayout": {
      "label": "Page layout",
      "plural": "Page layouts",
      "titleField": "title",
      "slugFrom": "title",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "label": "Page",
          "required": true
        },
        {
          "name": "path",
          "kind": "url",
          "label": "Address",
          "required": true,
          "help": "The page this arranges: / for Home."
        },
        {
          "name": "blocks",
          "kind": "layout",
          "label": "Arrangement",
          "help": "Drag the blocks on the page, or order and size them here."
        }
      ],
      "previewPath": "{path}"
    },
    "referencePage": {
      "label": "Reference Page Layout",
      "plural": "Reference Page Layouts",
      "menuUnder": "pageLayout",
      "titleField": "title",
      "slugFrom": "title",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "label": "Title",
          "required": true,
          "default": "Glossary of Terms"
        },
        {
          "name": "path",
          "kind": "url",
          "label": "Address",
          "required": true,
          "default": "/glossary",
          "help": "The page this fills: /glossary for the Glossary."
        },
        {
          "name": "eyebrow",
          "kind": "text",
          "label": "Small heading above the title",
          "default": "Reference"
        },
        {
          "name": "intro",
          "kind": "textarea",
          "label": "Introduction",
          "help": "Under the title. The term count and a link to the Library follow it."
        },
        {
          "name": "sections",
          "kind": "list",
          "label": "Sections",
          "itemLabel": "heading",
          "help": "Each is a category with its own jump button.",
          "fields": [
            {
              "name": "heading",
              "kind": "text",
              "label": "Category",
              "required": true
            },
            {
              "name": "terms",
              "kind": "list",
              "label": "Terms",
              "itemLabel": "term",
              "fields": [
                {
                  "name": "term",
                  "kind": "text",
                  "label": "Term",
                  "required": true
                },
                {
                  "name": "definition",
                  "kind": "richtext",
                  "label": "Definition",
                  "required": true
                },
                {
                  "name": "details",
                  "kind": "list",
                  "label": "Details",
                  "itemLabel": "label",
                  "help": "Labelled sub-definitions, e.g. rhinestone grades.",
                  "fields": [
                    {
                      "name": "label",
                      "kind": "text",
                      "label": "Label"
                    },
                    {
                      "name": "text",
                      "kind": "textarea",
                      "label": "Text",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "sources",
                  "kind": "list",
                  "label": "Sources",
                  "itemLabel": "title",
                  "help": "Each shows as its title, with the site and address in small type beneath.",
                  "fields": [
                    {
                      "name": "title",
                      "kind": "text",
                      "label": "Title",
                      "help": "What a reader sees, e.g. \"Victorian jewellery (Wikipedia)\". Blank: made from the address."
                    },
                    {
                      "name": "url",
                      "kind": "url",
                      "label": "Address",
                      "required": true
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "libraryIndex",
          "kind": "list",
          "label": "Library index",
          "itemLabel": "group",
          "help": "Groups of Library entries, by their exact titles.",
          "fields": [
            {
              "name": "group",
              "kind": "text",
              "label": "Group",
              "required": true
            },
            {
              "name": "entries",
              "kind": "list",
              "label": "Entries",
              "itemLabel": "title",
              "fields": [
                {
                  "name": "title",
                  "kind": "text",
                  "label": "Library entry title",
                  "required": true
                }
              ]
            }
          ]
        }
      ],
      "previewPath": "{path}"
    },
    "theme": {
      "label": "Theme",
      "plural": "Theme",
      "singleton": true,
      "previewPath": "/",
      "fields": [
        {
          "name": "defaultMode",
          "kind": "select",
          "label": "Opens in",
          "default": "blacklight",
          "options": [
            {
              "value": "blacklight",
              "label": "Blacklight"
            },
            {
              "value": "daylight",
              "label": "Light"
            }
          ],
          "help": "The look a visitor first sees."
        },
        {
          "name": "rememberChoice",
          "kind": "boolean",
          "label": "Remember each visitor’s last choice",
          "help": "Off: every visit opens in the look above, even for someone who switched last time. On: a returning visitor sees what they last chose."
        },
        {
          "name": "headingFont",
          "kind": "select",
          "label": "Heading font",
          "options": [
            {
              "value": "",
              "label": "Poiret One (current)"
            },
            {
              "value": "Josefin Sans",
              "label": "Josefin Sans"
            },
            {
              "value": "Limelight",
              "label": "Limelight"
            },
            {
              "value": "Cinzel",
              "label": "Cinzel"
            },
            {
              "value": "Marcellus",
              "label": "Marcellus"
            },

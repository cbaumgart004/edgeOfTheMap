        },
        {
          "name": "blacklightLabel",
          "kind": "text",
          "label": "Toggle label, blacklight",
          "default": "Blacklight"
        }
      ]
    },
    "menu": {
      "label": "Menu",
      "plural": "Menu",
      "singleton": true,
      "previewPath": "/meet-the-artist",
      "fields": [
        {
          "name": "items",
          "kind": "list",
          "label": "Menu items",
          "itemLabel": "label",
          "default": [
            {
              "_id": "nav-1",
              "page": null,
              "label": "Home",
              "url": "/",
              "soon": false
            },
            {
              "_id": "nav-2",
              "page": null,
              "label": "Library",
              "url": "/library",

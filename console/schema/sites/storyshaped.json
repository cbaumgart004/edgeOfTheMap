{
  "site": "storyshaped",
  "version": 1,
  "release": {
    "types": [
      "home",
      "artistPage",
      "page",
      "pageLayout",
      "referencePage",
      "theme"
    ]
  },
  "brand": {
    "name": "StoryShaped Studios",
    "logo": "/assets/StoryShapedStudiosLogo_GmailOptimized.png",
    "modeSource": {
      "selector": ".sss-home",
      "attribute": "data-mode",
      "map": {
        "daylight": "light",
        "blacklight": "dark"
      }
    },
    "modes": {
      "light": {
        "bg": "#0f1512",
        "surface": "#151d18",
        "ink": "#eef2d9",
        "muted": "#b3ca73",
        "line": "rgba(217,255,107,0.28)",
        "accent": "#d9ff6b",
        "accentInk": "#0f1512"
      },
      "dark": {
        "bg": "#060806",
        "surface": "#0d140d",
        "ink": "#d9f2d9",
        "muted": "#72ca72",
        "line": "rgba(0,251,0,0.35)",
        "accent": "#00fb00",
        "accentInk": "#060806"
      }
    },
    "fonts": {
      "body": "'Century Gothic', Futura, sans-serif",
      "heading": "'Poiret One', sans-serif"
    },
    "radius": "4px"
  },
  "textStyles": [
    {
      "name": "glow",
      "label": "Uranium glow",
      "className": "uv-glow"
    },
    {
      "name": "accent",
      "label": "Accent",
      "className": "text-accent"
    }
  ],
  "types": {
    "libraryArticle": {
      "label": "Library entry",
      "plural": "Library",
      "titleField": "title",
      "slugFrom": "title",

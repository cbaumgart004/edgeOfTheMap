{
  "site": "storyshaped",
  "version": 1,
  "brand": {
    "name": "StoryShaped Studios",
    "logo": "/assets/StoryShapedStudiosLogo_GmailOptimized.png",
    "modeSource": {
      "selector": ".sss-home",
      "attribute": "data-mode",
      "map": {
        "daylight": "light",
        "blacklight": "dark"
      }
    },
    "modes": {
      "light": {
        "bg": "#0f1512",
        "surface": "#151d18",
        "ink": "#eef2d9",
        "muted": "#b3ca73",
        "line": "rgba(217,255,107,0.28)",
        "accent": "#d9ff6b",
        "accentInk": "#0f1512"
      },
      "dark": {
        "bg": "#060806",
        "surface": "#0d140d",
        "ink": "#d9f2d9",
        "muted": "#72ca72",
        "line": "rgba(0,251,0,0.35)",
        "accent": "#00fb00",
        "accentInk": "#060806"
      }
    },
    "fonts": {
      "body": "'Century Gothic', Futura, sans-serif",
      "heading": "'Poiret One', sans-serif"
    },
    "radius": "4px"
  },
  "textStyles": [
    {
      "name": "glow",
      "label": "Uranium glow",
      "className": "uv-glow"
    },
    {
      "name": "accent",
      "label": "Accent",
      "className": "text-accent"
    }
  ],
  "types": {
    "libraryArticle": {
      "label": "Library entry",
      "plural": "Library",
      "titleField": "title",
      "slugFrom": "title",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "label": "Question or title",
          "required": true
        },
        {
          "name": "body",
          "kind": "richtext",
          "label": "Entry",
          "required": true
        },
        {
          "name": "after",
          "kind": "placement",
          "label": "Place in contents",
          "help": "Where this entry appears in the Library's contents."
        }
      ],
      "previewPath": "/library/{slug}"
    },
    "page": {
      "label": "Page",
      "plural": "Pages",
      "titleField": "title",
      "slugFrom": "title",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "label": "Title",
          "required": true
        },
        {
          "name": "sections",
          "kind": "blocks",
          "label": "Sections",
          "of": [
            "prose",
            "values",
            "photoFeature"
          ]
        }
      ],
      "previewPath": "/{slug}"
    },
    "pageLayout": {
      "label": "Page layout",
      "plural": "Page layouts",
      "titleField": "title",
      "slugFrom": "title",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "label": "Page",
          "required": true
        },
        {
          "name": "path",
          "kind": "url",
          "label": "Address",
          "required": true,
          "help": "The page this arranges: / for Home."
        },
        {
          "name": "blocks",
          "kind": "layout",
          "label": "Arrangement",
          "help": "Drag the blocks on the page, or order and size them here."
        }
      ],
      "previewPath": "{path}"
    }
  },
  "blocks": {
    "prose": {
      "label": "Text section",
      "className": "section prose-block",
      "fields": [
        {
          "name": "heading",
          "kind": "text",
          "label": "Heading"
        },
        {
          "name": "body",
          "kind": "richtext",
          "label": "Text"
        },
        {
          "name": "link",
          "kind": "group",
          "label": "Link",
          "fields": [
            {
              "name": "label",
              "kind": "text",
              "label": "Link text"
            },
            {
              "name": "url",
              "kind": "url",
              "label": "Link to"
            }
          ]
        }
      ]
    },
    "values": {
      "label": "Values grid",
      "className": "section values-grid",
      "fields": [
        {
          "name": "heading",
          "kind": "text",
          "label": "Heading"
        },
        {
          "name": "items",
          "kind": "list",
          "label": "Values",
          "itemLabel": "title",
          "fields": [
            {
              "name": "title",
              "kind": "text",
              "label": "Value",
              "required": true
            },
            {
              "name": "text",
              "kind": "textarea",
              "label": "Text"
            }
          ]
        }
      ]
    },
    "photoFeature": {
      "label": "Daylight / blacklight photo",
      "className": "hero-figure deco-corners",
      "fields": [
        {
          "name": "photos",
          "kind": "photos",
          "label": "Photos",
          "indexes": [
            "Light",
            "Dark"
          ]
        },
        {
          "name": "caption",
          "kind": "text",
          "label": "Caption"
        }
      ]
    }
  }
}

{
  "site": "edgeofthemap",
  "version": 1,
  "brand": {
    "name": "Edge of the Map",
    "logo": "/icon-192.png",
    "modeSource": { "selector": "body", "attribute": "data-face", "map": { "light": "light", "mystic-mode": "dark" } },
    "modes": {
      "light": { "bg": "#faf8f5", "surface": "#ffffff", "ink": "#191510", "muted": "#5f584e", "line": "#e3ddd3", "accent": "#0f766e", "accentInk": "#ffffff" },
      "dark": { "bg": "#101018", "surface": "#191527", "ink": "#ece5ff", "muted": "#aba0c6", "line": "rgba(122,77,231,0.34)", "accent": "#a1e7f5", "accentInk": "#14101f" }
    },
    "fonts": { "body": "system-ui, sans-serif", "heading": "'Cormorant Garamond', Georgia, serif" },
    "radius": "10px"
  },
  "buttonStyles": [
    { "value": "primary", "label": "Filled", "className": "btn btn-primary" },
    { "value": "ghost", "label": "Outline", "className": "btn btn-ghost" }
  ],
  "styleColors": [
    { "value": "accent", "label": "Accent (follows the face)", "css": "var(--accent)" },
    { "value": "ink", "label": "Text", "css": "var(--ink)" },
    { "value": "muted", "label": "Quiet text", "css": "var(--ink-muted)" },
    { "value": "ember", "label": "Ember", "css": "var(--ember)" },
    { "value": "surface", "label": "Card", "css": "var(--surface)" },
    { "value": "background", "label": "Background", "css": "var(--bg)" }
  ],
  "classes": [
    { "name": "btn", "label": "Buttons", "selector": ".btn" },
    { "name": "headings", "label": "Section headings", "selector": ".face h2" },
    { "name": "card", "label": "Craft cards", "selector": ".card" },
    { "name": "eyebrow", "label": "Small headings above a heading", "selector": ".eyebrow" },
    { "name": "sectionSub", "label": "Section introductions", "selector": ".section-sub" },
    { "name": "footer", "label": "Footer", "selector": ".site-footer" }
  ],
  "types": {
    "pageEdits": {
      "label": "Page",
      "plural": "Pages",
      "titleField": "page",
      "previewPath": "/",
      "overrides": "edits",
      "help": "Your changes to one page of the site, each kept against the element it changes. The site's own wording shows wherever nothing is changed.",
      "fields": [
        { "name": "page", "kind": "select", "label": "Page", "required": true, "options": [
          { "value": "home", "label": "Home" }, { "value": "keeper", "label": "The Keeper" },
          { "value": "storyteller", "label": "The Storyteller" }, { "value": "shell", "label": "Header and footer (every page)" } ] },
        { "name": "edits", "kind": "list", "label": "Changed elements", "itemLabel": "text",
          "help": "One row per element you changed on the page. Blank keeps the site's own, for every field.",
          "fields": [
            { "name": "text", "kind": "textarea", "label": "Words" },
            { "name": "html", "kind": "richtext", "label": "Formatted words", "help": "For a paragraph with links or emphasis; over Words when set." },
            { "name": "href", "kind": "url", "label": "Link" },
            { "name": "image", "kind": "image", "label": "Photo" },
            { "name": "class", "kind": "select", "label": "Class", "optionsFrom": "classes", "blankLabel": "None" },
            { "name": "style", "kind": "style", "label": "Style" },
            { "name": "hidden", "kind": "boolean", "label": "Hide it on the site" }
          ] }
      ]
    },
    "craft": {
      "label": "Craft",
      "plural": "Crafts",
      "titleField": "title",
      "previewPath": "/",
      "fields": [
        { "name": "key", "kind": "select", "label": "Which craft", "required": true, "options": [
          { "value": "keeper", "label": "The Keeper (Web & Systems)" },
          { "value": "storyteller", "label": "The Storyteller (Audio Narration)" },
          { "value": "wright", "label": "The Wright (Woodworking)" } ] },
        { "name": "title", "kind": "text", "label": "Title", "help": "Blank keeps the site's own wording, for every field here." },
        { "name": "persona", "kind": "text", "label": "Persona" },
        { "name": "blurb", "kind": "textarea", "label": "Card text (daylight)" },
        { "name": "loreBlurb", "kind": "textarea", "label": "Card text (mystic)" },
        { "name": "points", "kind": "list", "label": "Points", "itemLabel": "text", "fields": [
          { "name": "text", "kind": "text", "label": "Point", "required": true } ] },
        { "name": "cta", "kind": "text", "label": "Button text" }
      ]
    },
    "theme": {
      "label": "Theme",
      "plural": "Theme",
      "singleton": true,
      "previewPath": "/",
      "fields": [
        { "name": "daylight", "kind": "group", "label": "Daylight face", "fields": [
          { "name": "background", "kind": "color", "label": "Background" },
          { "name": "accent", "kind": "color", "label": "Accent (teal)" },
          { "name": "ember", "kind": "color", "label": "Ember (the reveal button)" },
          { "name": "text", "kind": "color", "label": "Text" } ] },
        { "name": "mystic", "kind": "group", "label": "Mystic face", "fields": [
          { "name": "background", "kind": "color", "label": "Background" },
          { "name": "glow", "kind": "color", "label": "Glow and accent" },
          { "name": "violet", "kind": "color", "label": "Violet (borders and haze)" },
          { "name": "text", "kind": "color", "label": "Text" } ] }
      ]
    }
  }
}
